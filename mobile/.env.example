# Copy to .env and fill in. Without these the app runs in demo mode with sample data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Google Maps (Android map tiles + Directions for driver routes)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
# From `eas init`
EAS_PROJECT_ID=
